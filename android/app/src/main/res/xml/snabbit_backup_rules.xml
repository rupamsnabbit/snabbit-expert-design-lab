<?xml version="1.0" encoding="utf-8"?>
<!--
  App-owned full-backup rules (Android 11 / API 30 and below).

  The app declares these (with tools:replace on <application>) because two libraries —
  Grant (KMP permissions) and AppsFlyer (analytics) — each ship their own
  android:fullBackupContent, which the manifest merger can't reconcile automatically.
  Backup policy is an app-level decision, so we union all the libraries' exclusions here
  rather than letting one transitive library's file win.

  Excluded (must NOT survive reinstall/restore):
   - grant_request_history.xml / snabbit_permissions_requested.xml — permission "requested
     before" flags. If restored onto a fresh install they'd misreport DENIED_ALWAYS when the
     OS actually sees the permission as never-asked. Each install must start fresh.
   - appsflyer-* / afpurchases.db — AppsFlyer's own state (mirrors its bundled rules).
   - FlutterSharedPreferences.xml — a PII carrier, not a settings file: the background FCM
     handler caches the whole `current_state` envelope into `flutter.cached_current_state`
     (customer name, phone, job address, hotspot lat/lng), and secure_storage_service falls
     back to writing `flutter.access_token` there in cleartext when Keystore fails. Neither
     may survive a restore onto a phone the runner sells, returns, or hands to a fleet
     operator. Benign Flutter prefs re-derive on a restored install — the right trade.
   - snabbit_runner_kmp_keyset_prefs.xml / the encrypted DataStore — the Tink keyset and the
     ciphertext it protects. The master key that unwraps the keyset lives in the Android
     Keystore, which is hardware-bound and never leaves the device, so a restore brings the
     keyset back WITHOUT its key. Tink then throws InvalidKeyException on construction and the
     app crash-loops on launch. Excluding both means a restored install simply mints a fresh
     keyset and the runner signs in again. They also hold the auth token, which must not ride
     a backup onto another phone regardless.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="grant_request_history.xml"/>
    <exclude domain="sharedpref" path="snabbit_permissions_requested.xml"/>
    <exclude domain="sharedpref" path="appsflyer-data"/>
    <exclude domain="sharedpref" path="appsflyer-purchase-data"/>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    <exclude domain="sharedpref" path="snabbit_runner_kmp_keyset_prefs.xml"/>
    <exclude domain="file" path="datastore/snabbit_runner_encrypted_store.preferences_pb"/>
    <exclude domain="database" path="afpurchases.db"/>
</full-backup-content>
